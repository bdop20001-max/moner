# ---------------------------------------------------------------------------
# Moner Manush — environment variables
# Copy this file to .env (local dev) and set real values in your hosting
# provider's dashboard for production. Never commit .env to git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. See README.md for MySQL / Cloudflare D1 notes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moner_manush?schema=public"

# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-this-to-a-long-random-string"

# WhatsApp number that all "WhatsApp-এ মেম্বারশিপ নিন" / floating chat
# buttons deep-link to, in international format without "+".
NEXT_PUBLIC_WHATSAPP_NUMBER="8801826785574"

# Maximum number of preview profiles visible without an active membership.
NEXT_PUBLIC_FREE_PROFILE_LIMIT="8"

# Public site URL, used for SEO metadata, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL="https://www.monermanush.net"

# Bootstrap admin account, only used by `npm run db:seed` to create the
# first admin login if one does not already exist.
SEED_ADMIN_EMAIL="admin@monermanush.net"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Directory (relative to project root) where uploaded member photos are
# stored in development. In production, point your storage layer at a
# private S3/R2 bucket instead — see README.md "Production photo storage".
UPLOADS_DIR="uploads"
